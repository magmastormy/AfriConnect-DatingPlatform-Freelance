# Dev image for the Next.js web app (local docker-compose only).
# Source is mounted as a volume; this just provides pnpm + node to run `next dev`.
FROM node:20-slim
ENV PNPM_HOME="/pnpm" && PATH="$PNPM_HOME:$PATH"
RUN corepack enable
WORKDIR /app
EXPOSE 3000
CMD ["sh", "-c", "pnpm install && pnpm --filter @africonnect/web dev"]
