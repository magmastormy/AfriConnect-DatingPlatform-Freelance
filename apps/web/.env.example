# ─────────────────────────────────────────────────────────────
# AfriConnect Professionals — WEB app environment template
# Copy to apps/web/.env and fill in. API-side vars (DATABASE_URL,
# JWT_*, PII_MASTER_KEY, Stripe, Twilio, email) live in the ROOT
# .env — the API process reads those. This file is for the Next.js
# frontend only. NEVER commit real secrets.
# ─────────────────────────────────────────────────────────────

# Where this site is served from (used for canonical/OG/sitemap).
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Obfuscated API mount segment — MUST match the API's API_MOUNT_PATH.
# The real API surface is served at /<this>/v1, not /api/v1.
NEXT_PUBLIC_API_MOUNT=36995461b66a8b6a44ccf6ccfe5aa8ce

# Backend API location (the Next rewrites proxy /<mount>/v1 here).
API_BASE_URL=http://localhost:4000

# WebSocket host for live chat, WITHOUT a path (e.g. ws://localhost:4000 or
# wss://africonnect-api.onrender.com). Next.js `rewrites` proxy HTTP only — they
# do NOT forward WebSocket upgrades — so this must point straight at the API.
# Leave blank only when the API is served from the same host as the site;
# otherwise useChatSocket falls back to window.location.host, the upgrade fails,
# and live chat silently degrades to REST polling.
NEXT_PUBLIC_API_WS=ws://localhost:4000

# Auth mode: "otp" (built-in phone OTP) or "clerk" (hosted Clerk).
# When set to "clerk", the Sign in / Sign up / Sign out flows use Clerk and
# the edge middleware protects member routes. The OTP fallback still works if
# you keep this as "otp" (or if Clerk keys are absent).
NEXT_PUBLIC_AUTH_MODE=clerk

# Clerk (REQUIRED when NEXT_PUBLIC_AUTH_MODE=clerk).
# Get keys from: https://dashboard.clerk.com/
# 1. Create a Clerk account and application
# 2. Copy your Publishable Key (starts with pk_test_)
# 3. Copy your Secret Key (starts with sk_test_)
# 4. NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY = Publishable Key (starts with pk_test_)
# 5. CLERK_SECRET_KEY = Secret Key (starts with sk_test_)
#
# IMPORTANT: These SAME keys must also be in the root .env file
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_your_publishable_key_here
CLERK_SECRET_KEY=sk_test_your_secret_key_here

# Leave empty unless you must pin a non-derived issuer. Derived from the
# publishable key by default: https://<instance>.clerk.accounts.dev
CLERK_ISSUER=
