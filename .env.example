# ─────────────────────────────────────────────────────────────────────────────
# AfriConnect Professionals — environment template
# Copy to `.env` and fill in. NEVER commit the real `.env` (see .gitignore).
# ─────────────────────────────────────────────────────────────────────────────

# ── Core ──────────────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=4000
API_BASE_URL=http://localhost:4000
WEB_BASE_URL=http://localhost:3000
# Obfuscated API mount segment (anti-enumeration). Generate: openssl rand -hex 16
# The web must use the SAME value via NEXT_PUBLIC_API_MOUNT. Defaults to "api".
API_MOUNT_PATH=36995461b66a8b6a44ccf6ccfe5aa8ce
LOG_LEVEL=info

# ── Postgres (used by docker-compose local full-stack) ──────────────────────────
POSTGRES_USER=africonnect
POSTGRES_PASSWORD=africonnect
POSTGRES_DB=africonnect
# In compose, DATABASE_URL is derived from the above; override here if needed.

# ── Database (PostgreSQL) ──────────────────────────────────────────────────────
# Local example: postgresql://user:password@localhost:5432/africonnect?schema=public
# Required to run prisma migrate / the running API.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/africonnect?schema=public
# Optional connection pool (PgBouncer) — leave blank to use DATABASE_URL directly
DATABASE_POOL_URL=

# ── Auth / JWT ──────────────────────────────────────────────────────────────────
# Generate with: openssl rand -base64 48
JWT_ACCESS_SECRET=change-me-access-secret
JWT_REFRESH_SECRET=change-me-refresh-secret
JWT_ACCESS_TTL_MINUTES=15
JWT_REFRESH_TTL_DAYS=7

# ── PII Encryption at rest (AES-256-GCM) ───────────────────────────────────────
# 32-byte key, base64-encoded. Generate: openssl rand -base64 32
PII_MASTER_KEY=change-me-32-byte-base64-key==

# ── Redis (OTP, rate-limit, sessions) ──────────────────────────────────────────
REDIS_URL=redis://localhost:6379

# ── CORS (whitelist only — Clause 3) ───────────────────────────────────────────
CORS_ORIGINS=http://localhost:3000,http://localhost:4000

# ── Email (Resend — PRIMARY verification channel) ────────────────────────────
# EMAIL_PROVIDER=resend sends real mail via Resend. Anything else (e.g. console)
# logs the rendered message to stdout so the flow works locally without creds.
EMAIL_PROVIDER=console            # console | resend
RESEND_API_KEY=
EMAIL_FROM=AfriConnect <no-reply@afri-connect.co.za>

# ── SMS / OTP (Twilio — SECONDARY verification fallback) ─────────────────────
# SMS is only used when a user cannot receive the primary email verification
# link. SMS_PROVIDER=twilio sends real SMS; console logs the OTP locally.
SMS_PROVIDER=console             # console | twilio
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
OTP_LENGTH=6
OTP_TTL_MINUTES=10

# ── Stripe (billing — TEST MODE ONLY) ───────────────────────────────────────
# Live keys (sk_live_) are REJECTED at boot. Only sk_test_ keys are accepted.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_DIGITAL_PRICE_ID=

# ── Media storage (Cloudinary) ──────────────────────────────────────────────
# MEDIA_PROVIDER=cloudinary stores images in Cloudinary. "local" (default) writes
# to ./uploads and serves them via the static /uploads route (no account needed).
MEDIA_PROVIDER=local             # local | cloudinary
CLOUDINARY_URL=

# ── Admin bootstrap ─────────────────────────────────────────────────────────
ADMIN_EMAIL=admin@afri-connect.co.za
ADMIN_SETUP_TOKEN=change-me-admin-bootstrap-token

# ── Clerk (optional hosted auth) ───────────────────────────────────────────────
# Set AUTH_PROVIDER=clerk (and CLERK_* below) to use Clerk as the primary sign-in.
# Leave as "otp" to use the built-in OTP (phone) flow.
AUTH_PROVIDER=otp
NEXT_PUBLIC_AUTH_MODE=otp
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
CLERK_JWKS_URL=https://api.clerk.dev/.well-known/jwks.json

# ── Public web config ──────────────────────────────────────────────────────────
NEXT_PUBLIC_SITE_URL=http://localhost:3000
