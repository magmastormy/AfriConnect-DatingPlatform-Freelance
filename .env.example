# ─────────────────────────────────────────────────────────────────────────────
# AfriConnect Professionals — environment template
# Copy to `.env` and fill in. NEVER commit the real `.env` (see .gitignore).
# ─────────────────────────────────────────────────────────────────────────────

# ── Core ──────────────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=4000
API_BASE_URL=http://localhost:4000
WEB_BASE_URL=http://localhost:3000
# Obfuscated API mount segment (anti-enumeration). Generate: openssl rand -hex 16
# The web must use the SAME value via NEXT_PUBLIC_API_MOUNT. Defaults to "api".
API_MOUNT_PATH=36995461b66a8b6a44ccf6ccfe5aa8ce
LOG_LEVEL=info

# ── Database (PostgreSQL via Aiven free tier) ────────────────────────────────
# We use Aiven's free PostgreSQL (https://aiven.io/free-postgresql-database) as the
# single source of truth for BOTH local dev and production. No Docker needed.
# Aiven REQUIRES TLS, so the URL must always end with `?sslmode=require`.
#
# Setup:
#   1. Create the service at aiven.io, then copy the "Service URI" from the console.
#   2. Paste it below, e.g.:
#      postgresql://avnadmin:YOUR_PASSWORD@YOUR_HOST.aivencloud.com:YOUR_PORT/defaultdb?sslmode=require
#   3. Use the SAME URL for the API (here) and for the Render `DATABASE_URL` env var.
DATABASE_URL=postgresql://avnadmin:YOUR_AIVEN_PASSWORD@YOUR_HOST.aivencloud.com:YOUR_PORT/defaultdb?sslmode=require

# ── Postgres (legacy docker-compose — no longer used) ─────────────────────────
# The app now runs against Aiven; docker-compose's `db` service has been removed.
# Kept as a reference only — set these and point DATABASE_URL at localhost if you
# ever want a local Postgres instead.
# POSTGRES_USER=africonnect
# POSTGRES_PASSWORD=africonnect
# POSTGRES_DB=africonnect

# ── Auth / JWT ──────────────────────────────────────────────────────────────────
# Generate with: openssl rand -base64 48
JWT_ACCESS_SECRET=change-me-access-secret
JWT_REFRESH_SECRET=change-me-refresh-secret
JWT_ACCESS_TTL_MINUTES=15
JWT_REFRESH_TTL_DAYS=7

# ── PII Encryption at rest (AES-256-GCM) ───────────────────────────────────────
# 32-byte key, base64-encoded. Generate: openssl rand -base64 32
PII_MASTER_KEY=change-me-32-byte-base64-key==

# ── Redis (OTP, rate-limit, sessions) ──────────────────────────────────────────
REDIS_URL=redis://localhost:6379

# ── CORS (whitelist only — Clause 3) ───────────────────────────────────────────
CORS_ORIGINS=http://localhost:3000,http://localhost:4000

# ── Email (Resend — PRIMARY verification channel) ────────────────────────────
# EMAIL_PROVIDER=resend sends real mail via Resend. Anything else (e.g. console)
# logs the rendered message to stdout so the flow works locally without creds.
EMAIL_PROVIDER=console            # console | resend
RESEND_API_KEY=
EMAIL_FROM=AfriConnect <no-reply@afri-connect.co.za>

# ── SMS / OTP (Twilio — SECONDARY verification fallback) ─────────────────────
# SMS is only used when a user cannot receive the primary email verification
# link. SMS_PROVIDER=twilio sends real SMS; console logs the OTP locally.
SMS_PROVIDER=console             # console | twilio
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
OTP_LENGTH=6
OTP_TTL_MINUTES=10

# ── Stripe (billing — TEST MODE ONLY) ───────────────────────────────────────
# Live keys (sk_live_) are REJECTED at boot. Only sk_test_ keys are accepted.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Price IDs per subscription plan — must match the Price IDs in your Stripe dashboard.
STRIPE_PRICE_PREMIUM=
STRIPE_PRICE_PLATINUM=

# ── Media storage ───────────────────────────────────────────────────────────
# MEDIA_PROVIDER controls where user-uploaded images are stored:
#   local      -> writes to ./uploads (dev fallback, no account needed)
#   cloudinary -> stores in Cloudinary (requires CLOUDINARY_URL)
#   r2         -> stores in Cloudflare R2 (requires R2_* variables below)
MEDIA_PROVIDER=local             # local | cloudinary | r2
CLOUDINARY_URL=

# ── Cloudflare R2 (S3-compatible object storage) ───────────────────────────
# Required when MEDIA_PROVIDER=r2. R2 is AWS S3-compatible; get credentials
# from the Cloudflare dashboard > R2 > Manage R2 API Tokens.
# R2_CDN_DOMAIN is optional — set it to serve images via a custom CDN domain.
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_ACCOUNT_ID=
R2_BUCKET_NAME=
R2_CDN_DOMAIN=

# ── Admin bootstrap ─────────────────────────────────────────────────────────
ADMIN_EMAIL=admin@afri-connect.co.za
# Optional: email granted super-admin role on first seed (defaults to superadmin@afri-connect.co.za).
SUPERADMIN_EMAIL=superadmin@afri-connect.co.za
ADMIN_SETUP_TOKEN=change-me-admin-bootstrap-token

# ── Clerk (Primary Authentication) ───────────────────────────────────────────────
# Clerk handles sign-in, sign-up, and sign-out. Get keys from: https://dashboard.clerk.com/
# 1. Create a Clerk account and application
# 2. Copy your Publishable Key (starts with pk_test_) 
# 3. Copy your Secret Key (starts with sk_test_)
# 4. Set NEXT_PUBLIC_AUTH_MODE=clerk to enable Clerk auth
#
# IMPORTANT: Both .env (root) AND apps/web/.env need Clerk keys configured
#
# Root .env (API backend):
NEXT_PUBLIC_AUTH_MODE=clerk
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_your_publishable_key_here
CLERK_SECRET_KEY=sk_test_your_secret_key_here
# Used by the API to verify Clerk tokens when NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY is
# not injected into the API process (e.g. on Render).
CLERK_PUBLISHABLE_KEY=
# CLERK_ISSUER is auto-derived from publishable key - leave blank unless using custom domain
CLERK_ISSUER=
# Optional JWKS override. Leave blank in normal use — the API derives
# `<issuer>/.well-known/jwks.json` from the publishable key. Only set this when
# Clerk serves signing keys from a non-standard host (e.g. a proxied domain).
CLERK_JWKS_URL=

# ── Public web config ──────────────────────────────────────────────────────────
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Optional: explicit WebSocket host for realtime chat (defaults to the current browser host).
NEXT_PUBLIC_API_WS=
# Optional: forward contact-form inquiries to this webhook (Slack/Discord/Resend inbound).
CONTACT_WEBHOOK_URL=

# ── Mock Chat (LLM-powered personas) ────────────────────────────────────────────
# Enable mock chat feature (requires MOCK_CHAT_ENABLED=true to activate)
MOCK_CHAT_ENABLED=false

# LLM Provider: openai | anthropic | groq | local | mock
# - openai: Requires OPENAI_API_KEY
# - anthropic: Requires ANTHROPIC_API_KEY
# - groq: Requires GROQ_API_KEY (fastest inference, OpenAI-compatible API)
# - local: Requires LOCAL_LLM_URL (e.g., http://localhost:11434 for Ollama)
# - mock: No credentials needed, returns simulated responses (for testing)
MOCK_CHAT_LLM_PROVIDER=mock

# OpenAI Configuration
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_BASE_URL=https://api.openai.com/v1

# Anthropic Configuration
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-3-haiku-20240307

# Groq Configuration (OpenAI-compatible, optimized for speed)
# Docs: https://console.groq.com/docs/overview
# Get API key: https://console.groq.com/keys
# NOTE: Groq retires models on short notice. llama-3.3-70b-versatile was shut
# down for free/developer tiers on 2026-08-16 and now returns 400
# `model_decommissioned`. Check https://console.groq.com/docs/deprecations
# before pinning a model.
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
GROQ_BASE_URL=https://api.groq.com/openai/v1

# Local LLM Configuration (Ollama, llama.cpp, LM Studio, etc.)
LOCAL_LLM_URL=http://localhost:11434
LOCAL_LLM_MODEL=llama3.1:8b

# Mock Chat Behavior
MOCK_CHAT_AUTO_RESPOND=true
MOCK_CHAT_RESPONSE_DELAY_MIN=500
MOCK_CHAT_RESPONSE_DELAY_MAX=2000
MOCK_CHAT_MAX_CONCURRENT=100
MOCK_CHAT_RATE_LIMIT=30
MOCK_CHAT_DEFAULT_PERSONA_ID=
