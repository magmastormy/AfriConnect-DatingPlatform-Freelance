generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  // Aiven free PostgreSQL requires TLS — ensure DATABASE_URL ends with ?sslmode=require
  url      = env("DATABASE_URL")
}

// ─────────────────────────────────────────────────────────────────────────────
// Module: AUTH  (prefix: auth_)  — Technical Stack §3 Module 1
// ─────────────────────────────────────────────────────────────────────────────
model User {
  id            String    @id @default(uuid())
  email         String    @unique
  phone         String    @unique
  role          UserRole  @default(applicant)
  status        UserStatus @default(pending)
  emailVerified Boolean   @default(false)
  phoneVerified Boolean   @default(false)
  clerkId       String?   @unique // linked Clerk identity, when using Clerk auth
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  profile         Profile?
  applications    Application[]
  sessions        Session[]
  subscriptions   Subscription?
  matchesAsUser   Match[]      @relation("MatchUser")
  matchesAsTarget Match[]      @relation("MatchTarget")
  conversations1  Conversation[] @relation("ConvP1")
  conversations2  Conversation[] @relation("ConvP2")
  messages        Message[]
  rsvps           RSVP[]
  starsGiven      EventStar[]  @relation("StarGiver")
  starsReceived   EventStar[]  @relation("StarReceiver")
  notifications   Notification[]
  prefs           NotificationPreference?
  payments        Payment[]
  dailyQueues     DailyMatchQueue[]
  adminAuditLogs  AdminAudit[]
  verificationTokens VerificationToken[]
  // Analytics relations (Change C) — parent side of the ProfileView edges.
  // No columns are added here; the FKs live on analytics_profile_views.
  profileViewsGiven   ProfileView[] @relation("ProfileViewer")
  profileViewsReceived ProfileView[] @relation("ProfileViewed")
  vettingSessions    VettingSession[] @relation("UserVettingSessions")

  @@map("auth_users")
}

model Session {
  id         String   @id @default(uuid())
  userId     String
  tokenHash  String   @unique
  jti        String   @unique // opaque session id, embedded in the refresh token
  deviceId   String?  // device binding (X-Device-Id); null for legacy sessions
  deviceInfo Json?
  ipAddress  String?
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("auth_sessions")
}

// Email verification tokens (PRIMARY verification channel). A token is emailed as
// a link; redeeming it sets User.emailVerified. Distinct from the SMS OTP store
// (otpStore.ts), which is the SECONDARY fallback for users without email access.
model VerificationToken {
  id        String   @id @default(uuid())
  userId    String
  // SHA-256 of the opaque token sent in the email link (never stored raw).
  tokenHash String   @unique
  purpose   String   @default("email_verify") // email_verify | email_reverify
  expiresAt DateTime
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("auth_verification_tokens")
}

// ─────────────────────────────────────────────────────────────────────────────
// Module: APPLICATION / VETTING  (prefix: vetting_)  — §3 Module 2
// ─────────────────────────────────────────────────────────────────────────────
model Application {
  id                   String            @id @default(uuid())
  userId               String?
  firstName            String
  lastName             String
  email                String
  phone                String
  dateOfBirth          DateTime
  gender               Gender
  nationality          String
  profession           String
  employer             String
  linkedInUrl          String? // optional now: proof-of-work is an alternative (Change B)
  educationLevel       EducationLevel
  institution          String
  relationshipGoals    RelationshipGoal? // no longer collected in the 2-step flow
  city                 City
  status               ApplicationStatus @default(submitted)
  adminNotes           String?
  reviewedBy           String?
  reviewedAt           DateTime?
  createdAt            DateTime          @default(now())
  updatedAt            DateTime          @updatedAt
  idDocumentUrl        String
  degreeCertificateUrl String? // optional now: degree cert is no longer mandatory
  selfieUrl            String
  proofOfWorkUrl       String? // NEW (Change B): proof-of-work upload, alt to LinkedIn
  proofOfWorkType     String? // one of PROOF_OF_WORK_TYPES (resume|work_badge|selfie_company|linkedin)
  user                 User?             @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([status])
  @@map("vetting_applications")
}

// ─────────────────────────────────────────────────────────────────────────────
// Module: PROFILE  (prefix: profile_)  — §3 Module 3
// ─────────────────────────────────────────────────────────────────────────────
model Profile {
  id                 String   @id @default(uuid())
  userId             String   @unique
  firstName          String
  lastName           String
  displayName        String?
  // Nullable so a member can save a partial profile from the account page
  // (account-first onboarding) before they capture a full date of birth.
  dateOfBirth        DateTime?
  gender             Gender
  nationality        String? // launch-market limited (ZA / ZW); shown on RedNote cards
  city               City
  bio                String?  @db.Text
  headline           String?  @db.Text // short tagline shown on discovery cards
  profession         String?
  employer           String?
  heightCm           Int?
  educationLevel     EducationLevel?
  institution        String?
  industries         String[]    @default([]) // multi-select during onboarding
  interests          String[]
  dealbreakers       String[]
  photos             Json?
  preferences        Json?
  privacy            Json?
  isPaused           Boolean  @default(false)
  isComplete         Boolean  @default(false)
  completenessScore  Int      @default(0)
  // WeChat-Nearby (district-scoped discovery, premium feature). `district` is a
  // free-text suburb/neighbourhood within `city`; `nearbyEnabled` is the member's
  // opt-in. Only profiles with nearbyEnabled=true are returned to nearby viewers.
  district           String?
  nearbyEnabled      Boolean  @default(false)
  // Precise geolocation captured from the browser when a member opts into
  // WeChat-Nearby. Cleared (set null) when they drop their location.
  latitude           Float?
  longitude          Float?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
  user               User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([city])
  @@index([gender])
  @@index([educationLevel])
  @@index([isPaused, isComplete])
  @@index([city, district, nearbyEnabled])
  @@index([nearbyEnabled, latitude, longitude])
  @@map("profile_profiles")
}

// ─────────────────────────────────────────────────────────────────────────────
// Module: MATCH  (prefix: match_)  — §3 Module 4
// ─────────────────────────────────────────────────────────────────────────────
model Match {
  id                String       @id @default(uuid())
  userId            String
  matchedUserId     String
  status            MatchStatus  @default(pending)
  compatibilityScore Int?
  userAction        MatchAction?
  matchedUserAction MatchAction?
  matchedAt         DateTime?
  createdAt         DateTime     @default(now())
  user              User         @relation("MatchUser", fields: [userId], references: [id], onDelete: Cascade)
  matchedUser       User         @relation("MatchTarget", fields: [matchedUserId], references: [id], onDelete: Cascade)

  @@index([userId, status])
  @@index([userId, matchedUserId, status])
  @@map("match_matches")
}

model DailyMatchQueue {
  id          String   @id @default(uuid())
  userId      String
  matches     Json
  generatedAt DateTime @default(now())
  expiresAt   DateTime
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("match_daily_queues")
}

// ─────────────────────────────────────────────────────────────────────────────
// Module: CHAT  (prefix: chat_)  — §3 Module 5
// ─────────────────────────────────────────────────────────────────────────────
model Conversation {
  id              String   @id @default(uuid())
  participant1Id  String
  participant2Id  String
  lastMessageId   String?
  lastMessageAt   DateTime?
  unreadCountP1   Int      @default(0)
  unreadCountP2   Int      @default(0)
  isActive        Boolean  @default(true)
  createdAt       DateTime @default(now())
  participant1    User     @relation("ConvP1", fields: [participant1Id], references: [id], onDelete: Cascade)
  participant2    User     @relation("ConvP2", fields: [participant2Id], references: [id], onDelete: Cascade)
  messages        Message[]

  @@index([participant1Id])
  @@index([participant2Id])
  @@map("chat_conversations")
}

model Message {
  id             String        @id @default(uuid())
  conversationId String
  senderId       String
  content        String        @db.Text
  imageUrl       String?       // image message (stored object URL)
  status         MessageStatus @default(sent)
  isEdited       Boolean       @default(false)
  editedAt       DateTime?
  isDeleted      Boolean       @default(false) // soft delete (content redacted)
  deletedAt      DateTime?
  recalledAt     DateTime?     // sender recalled within window
  createdAt      DateTime      @default(now())
  conversation   Conversation  @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  sender         User          @relation(fields: [senderId], references: [id], onDelete: Cascade)

  @@index([conversationId, createdAt])
  @@map("chat_messages")
}

// ─────────────────────────────────────────────────────────────────────────────
// Module: EVENT  (prefix: event_)  — §3 Module 6
// ─────────────────────────────────────────────────────────────────────────────
model Event {
  id            String       @id @default(uuid())
  title         String
  description   String       @db.Text
  eventType     EventType
  city          City
  venueName     String
  venueAddress  String
  venueMapUrl   String?
  startTime     DateTime
  endTime       DateTime
  capacity      Int
  ticketPrice   Decimal      @default(0)
  dressCode     String?
  status        EventStatus  @default(draft)
  featured      Boolean      @default(false)
  createdBy     String?
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt
  rsvps         RSVP[]
  stars         EventStar[]

  @@index([city, status])
  @@map("event_events")
}

model RSVP {
  id          String     @id @default(uuid())
  eventId     String
  userId      String
  status      RSVPStatus @default(confirmed)
  checkedInAt DateTime?
  createdAt   DateTime   @default(now())
  event       Event      @relation(fields: [eventId], references: [id], onDelete: Cascade)
  user        User       @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([eventId, userId])
  @@index([eventId, status])
  @@index([userId])
  @@map("event_rsvps")
}

model EventStar {
  id          String   @id @default(uuid())
  eventId     String
  starerId    String
  starreeId   String
  isMutual    Boolean  @default(false)
  revealedAt  DateTime?
  createdAt   DateTime @default(now())
  event       Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)
  starer      User     @relation("StarGiver", fields: [starerId], references: [id], onDelete: Cascade)
  starree     User     @relation("StarReceiver", fields: [starreeId], references: [id], onDelete: Cascade)

  @@unique([eventId, starerId, starreeId])
  @@index([eventId, starerId])
  @@map("event_stars")
}

// ─────────────────────────────────────────────────────────────────────────────
// Module: BILLING  (prefix: billing_)  — §3 Module 7
// ─────────────────────────────────────────────────────────────────────────────
model Subscription {
  id                   String             @id @default(uuid())
  userId               String             @unique
  stripeCustomerId     String?
  stripeSubscriptionId String?
  plan                 SubscriptionPlan
  status               SubscriptionStatus @default(trialing)
  currentPeriodStart   DateTime?
  currentPeriodEnd     DateTime?
  cancelAtPeriodEnd    Boolean            @default(false)
  createdAt            DateTime           @default(now())
  updatedAt            DateTime           @updatedAt
  user                 User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  payments             Payment[]

  @@map("billing_subscriptions")
}

model Payment {
  id                    String         @id @default(uuid())
  userId                String
  subscriptionId        String?
  eventId               String?
  amount                Decimal
  currency              String         @default("ZAR")
  status                PaymentStatus  @default(pending)
  stripePaymentIntentId String?
  receiptUrl            String?
  createdAt             DateTime       @default(now())
  user                  User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  subscription          Subscription?  @relation(fields: [subscriptionId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@map("billing_payments")
}

// ─────────────────────────────────────────────────────────────────────────────
// Module: NOTIFICATION  (prefix: notify_)  — §3 Module 8
// ─────────────────────────────────────────────────────────────────────────────
model Notification {
  id        String               @id @default(uuid())
  userId    String
  type      String
  title     String
  body      String               @db.Text
  link      String?              @db.Text
  data      Json?
  channel   NotificationChannel
  isRead    Boolean              @default(false)
  sentAt    DateTime?
  readAt    DateTime?
  createdAt DateTime             @default(now())
  user      User                 @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, isRead])
  @@map("notify_notifications")
}

model NotificationPreference {
  id     String @id @default(uuid())
  userId String @unique
  email  Json?
  sms    Json?
  push   Json?
  inApp  Json?
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("notify_preferences")
}

// ─────────────────────────────────────────────────────────────────────────────
// Module: VETTING (KYC)  (prefix: vetting_)  — Smile ID identity verification
// ─────────────────────────────────────────────────────────────────────────────
// Tracks a KYC verification session started for a member. The webhook (live) or
// the /vetting/sandbox simulator (testing) resolves the session to a decision,
// which flips the member to the Verified stage. externalRef stores the provider's
// job/tracking id so the asynchronous callback can be mapped back to the user.
model VettingSession {
  id         String   @id @default(uuid())
  userId     String
  provider   String   @default("smile")
  externalRef String?
  mode       String   @default("sandbox") // sandbox | live
  status     String   @default("pending") // pending | approved | rejected
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  user       User     @relation("UserVettingSessions", fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([externalRef])
  @@map("vetting_sessions")
}

// ─────────────────────────────────────────────────────────────────────────────
// Enums (mirror packages/shared/src/types.ts)
// ─────────────────────────────────────────────────────────────────────────────
enum UserRole {
  applicant
  member
  premium
  admin
  admin_vetting
  admin_events
  admin_billing
  admin_support
  admin_content
  superadmin
}

enum UserStatus {
  pending
  active
  suspended
  banned
}

enum Gender {
  male
  female
  non_binary
  other
}

enum City {
  johannesburg
  cape_town
  pietermaritzburg
  durban
  pretoria
}

enum EducationLevel {
  diploma
  bachelors
  honours
  masters
  phd
  professional
}

enum RelationshipGoal {
  marriage
  long_term
  companionship
  friendship
}

enum ApplicationStatus {
  submitted
  under_review
  approved
  rejected
  on_hold
}

enum MatchStatus {
  pending
  liked
  passed
  mutual
  unmatched
}

enum MatchAction {
  liked
  passed
  superliked
}

enum EventStatus {
  draft
  pending
  published
  cancelled
  completed
}

enum EventType {
  wine_dine
  mixer
  themed
  gala
}

enum RSVPStatus {
  confirmed
  waitlist
  cancelled
  attended
  no_show
}

enum SubscriptionPlan {
  digital_access
  premium
  platinum
}

enum SubscriptionStatus {
  trialing
  active
  past_due
  cancelled
  expired
}

enum PaymentStatus {
  pending
  succeeded
  failed
  refunded
}

enum NotificationChannel {
  email
  sms
  push
  in_app
}

enum MessageStatus {
  sent
  delivered
  read
}

// ─────────────────────────────────────────────────────────────────────────────
// Module: ADMIN  (prefix: admin_)  — §3 Module 9 (role-split management)
// ─────────────────────────────────────────────────────────────────────────────
enum AdminScope {
  vetting
  events
  billing
  support
  content
  super
}

model AdminAudit {
  id        String    @id @default(uuid())
  adminId   String
  action    String // e.g. "member.suspend", "application.approve", "role.assign"
  entity    String // e.g. "user", "application", "event", "subscription"
  entityId  String?
  scope     AdminScope
  metadata  Json?
  ipAddress String?
  createdAt DateTime  @default(now())

  admin User @relation(fields: [adminId], references: [id], onDelete: Cascade)

  @@index([adminId])
  @@index([entity, entityId])
  @@map("admin_audit_logs")
}

// ─────────────────────────────────────────────────────────────────────────────
// Module: ANALYTICS  (prefix: analytics_)  — Change C (profile-view tracking)
// ─────────────────────────────────────────────────────────────────────────────
model ProfileView {
  id           String   @id @default(uuid())
  viewerId     String // the member who viewed
  viewedUserId String // the member whose profile/card was viewed
  createdAt    DateTime @default(now())

  viewer  User @relation("ProfileViewer",  fields: [viewerId],     references: [id], onDelete: Cascade)
  viewed  User @relation("ProfileViewed",  fields: [viewedUserId], references: [id], onDelete: Cascade)

  @@index([viewerId, createdAt])
  @@index([viewedUserId, createdAt])
  @@map("analytics_profile_views")
}

// ─────────────────────────────────────────────────────────────────────────────
// Module: SETTINGS  (prefix: settings_)  — Platform gating/CRM configuration
// ─────────────────────────────────────────────────────────────────────────────
// Singleton row (id fixed to 1) holding the operator-tunable knobs that drive
// discovery gating: how many extra photos a restricted (free+vetted) viewer may
// see of a premium+vetted member, the free→premium connection cap, and which
// profile fields are withheld from restricted viewers. Managed from the admin
// "CRM of settings" console; the API caches the row and falls back to shared
// constants if the table is unreachable.
model PlatformSettings {
  id                          Int       @id @default(1)
  freeViewMaxExtraPhotos     Int       @default(1)
  freePremiumConnectionLimit Int       @default(5)
  restrictedHiddenFields     String[]  @default(["nationality", "profession", "educationLevel", "dateOfBirth"])
  updatedAt                  DateTime  @updatedAt
  updatedBy                  String?

  @@map("platform_settings")
}

// ─────────────────────────────────────────────────────────────────────────────
// Module: WEBHOOKS  (prefix: webhook_)  — idempotency ledger
// ─────────────────────────────────────────────────────────────────────────────
// Records every provider webhook event id we have processed so a redelivery
// (Stripe and Smile ID both retry) cannot double-apply a side effect — e.g.
// granting a subscription twice or flipping a member to Verified twice. The
// (provider, eventId) unique constraint makes the check atomic across the
// horizontal fleet.
model WebhookEvent {
  id        String   @id @default(uuid())
  provider  String // 'stripe' | 'smile'
  eventId   String // provider event id (Stripe event.id, Smile job_id / signature)
  status    String   @default("processed") // processed | ignored
  createdAt DateTime @default(now())

  @@unique([provider, eventId])
  @@index([createdAt])
  @@map("webhook_events")
}
