{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "module": "CommonJS",
    "moduleResolution": "Node",
    "outDir": "dist",
    "rootDir": "./src",
    "declaration": false,
    "baseUrl": ".",
    "paths": {
      "@config/middleware/auth": ["src/config/middleware/auth.ts"],
      "@config/middleware/rateLimit": ["src/config/middleware/rateLimit.ts"],
      "@config/middleware/validate": ["src/config/middleware/validate.ts"],
      "@config/middleware/device": ["src/config/middleware/device.ts"],
      "@modules/*": ["src/modules/*"],
      "@config/*": ["src/config/*"],
      "@config/jwt": ["src/config/jwt.ts"],
      "@config/index": ["src/config/index.ts"],
      "@config/prisma": ["src/config/prisma.ts"],
      "@config/providers": ["src/config/providers.ts"],
      "@config/rateLimiter": ["src/config/rateLimiter.ts"],
      "@config/middleware": ["src/config/middleware/index.ts"],
      "@config/middleware/device": ["src/config/middleware/device.ts"],
      "@webhooks/*": ["src/webhooks/*"],
      "@webhooks/dedupe": ["src/webhooks/dedupe.ts"]
    }
  },
  "include": ["src/**/*.ts"],
  "exclude": [
    "node_modules",
    "dist",
    "**/*.test.ts",
    "prisma/**",
    "scripts/test-harness/**",
    "scripts/perf/**",
    "scripts/load/**",
    "scripts/bench/**",
    "scripts/e2e/**"
  ]
}
