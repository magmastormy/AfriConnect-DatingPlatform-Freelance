{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "nextjs",
  "buildCommand": "pnpm --filter @africonnect/web build",
  "installCommand": "pnpm install",
  "outputDirectory": "apps/web/.next",
  "rootDirectory": ".",
  "env": {
    "NEXT_PUBLIC_SITE_URL": "@africonnect-site-url",
    "NEXT_PUBLIC_API_MOUNT": "@africonnect-api-mount",
    "NEXT_PUBLIC_API_WS": "@africonnect-api-ws",
    "API_BASE_URL": "@africonnect-api-base"
  }
}
